#!/usr/bin/env python3
"""Write the Pi Room alarm sound: a soft marimba-like phrase on an F major 7 chord, one WAV file, about 4.5 s.

  pi-alarm-chime OUT.wav

pi-dashboard-server plays it again and again while an alarm rings, so the phrase ends with a short rest.
Kept below ~2 kHz (no bright partials) with a 6 ms attack, so it wakes without piercing.  Stdlib only.
"""
import math, struct, sys, wave

RATE = 44100
LENGTH_S = 4.5
PEAK = 0.5                          # of full scale; the phrase is mixed, then scaled to this
F4, G4, A4, C5, D5, E5 = 349.23, 392.00, 440.00, 523.25, 587.33, 659.26
# (start s, frequency Hz, loudness): an arpeggio up, a short answer down, then a chord left to ring
NOTES = [(0.00, F4, 1.0), (0.16, A4, 0.9), (0.32, C5, 0.9), (0.48, E5, 1.0),
         (1.10, D5, 0.8), (1.26, C5, 0.7), (1.42, A4, 0.8),
         (1.80, G4, 0.6), (1.80, C5, 0.5), (1.96, F4, 0.9), (1.96, A4, 0.7), (1.96, C5, 0.6)]
# (multiple of the note, level, decay time constant s): the 4x partial gives the wooden mallet knock and dies fast
PARTIALS = [(1.0, 1.0, 0.70), (2.0, 0.12, 0.35), (4.0, 0.18, 0.06)]
ATTACK_S = 0.006


def main(out):
    n = int(RATE * LENGTH_S)
    buf = [0.0] * n
    for start, freq, loud in NOTES:
        i0 = int(start * RATE)
        for k in range(min(n - i0, int(RATE * 2.5))):
            t = k / RATE
            env = min(1.0, t / ATTACK_S)
            buf[i0 + k] += loud * env * sum(level * math.exp(-t / tau) * math.sin(2 * math.pi * freq * mult * t)
                                            for mult, level, tau in PARTIALS)
    fade = int(RATE * 0.3)              # end exactly at zero, so the repeat does not click
    for k in range(fade):
        buf[n - fade + k] *= 1 - k / fade
    scale = PEAK / max(abs(x) for x in buf)
    with wave.open(out, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(RATE)
        w.writeframes(b"".join(struct.pack("<h", round(x * scale * 32767)) for x in buf))


if __name__ == "__main__":
    if len(sys.argv) != 2:
        sys.exit(__doc__.strip().splitlines()[2].strip())
    main(sys.argv[1])
