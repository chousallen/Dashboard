#!/usr/bin/env python3
"""Monitor off while the Pi Room is idle (pi-dashboard-blank.service, root).

cage cannot switch the HDMI output off (cage 0.1.4 has no output-power protocol).  Once pi-dashboard.service (cage)
is stopped, this script opens the DRM device, becomes DRM master, and disables every CRTC: the HDMI signal stops and
the monitor sleeps.  It keeps the device open while it waits for the first key press on any input device, then
closes it (the kernel console comes back by itself) and starts pi-dashboard.service.  The key goes to the (empty)
console, never to the page, so Enter cannot start the stream from a dark screen.

Why not a console blank (setterm --blank force)?  That did turn DPMS off, but this monitor drops its hotplug line
~7 s into standby; the kernel's fbdev helper then re-probes and re-enables the output, so the console came back on
its own.  The helper skips that restore while another process holds DRM master, which is what this script does.
Same raw-evdev loop as pi-console-keys; stdlib + libdrm.so.2 via ctypes.
"""
import ctypes, ctypes.util, os, select, struct, subprocess, time

EV_KEY = 1
EVENT = struct.calcsize("llHHi")
DASHBOARD = "pi-dashboard.service"
CARD = "/dev/dri/card1"            # vc4-drm; card0 is v3d (render only)


class DrmModeRes(ctypes.Structure):
    _fields_ = [("count_fbs", ctypes.c_int), ("fbs", ctypes.POINTER(ctypes.c_uint32)),
                ("count_crtcs", ctypes.c_int), ("crtcs", ctypes.POINTER(ctypes.c_uint32)),
                ("count_connectors", ctypes.c_int), ("connectors", ctypes.POINTER(ctypes.c_uint32)),
                ("count_encoders", ctypes.c_int), ("encoders", ctypes.POINTER(ctypes.c_uint32)),
                ("min_width", ctypes.c_uint32), ("max_width", ctypes.c_uint32),
                ("min_height", ctypes.c_uint32), ("max_height", ctypes.c_uint32)]


def log(msg):
    print(msg, flush=True)


def display_off():
    """Become DRM master and disable all CRTCs. Returns the open fd; closing it hands the display back to fbcon."""
    drm = ctypes.CDLL(ctypes.util.find_library("drm") or "libdrm.so.2")
    drm.drmModeGetResources.restype = ctypes.POINTER(DrmModeRes)
    drm.drmModeSetCrtc.argtypes = [ctypes.c_int, ctypes.c_uint32, ctypes.c_uint32, ctypes.c_uint32, ctypes.c_uint32,
                                   ctypes.c_void_p, ctypes.c_int, ctypes.c_void_p]
    fd = os.open(CARD, os.O_RDWR | os.O_CLOEXEC)
    if drm.drmSetMaster(fd) != 0:
        raise SystemExit(f"{CARD}: cannot become DRM master (is cage still running?)")
    res = drm.drmModeGetResources(fd)
    if not res:
        raise SystemExit(f"{CARD}: drmModeGetResources failed")
    for i in range(res.contents.count_crtcs):
        crtc = res.contents.crtcs[i]
        rc = drm.drmModeSetCrtc(fd, crtc, 0, 0, 0, None, 0, None)   # fb 0, no connectors, no mode = off
        log(f"crtc {crtc} off: rc={rc}")
    drm.drmModeFreeResources(res)
    return fd


def wait_for_key():
    fds = {}          # fd -> path
    last_scan = 0.0
    poller = select.poll()
    while True:
        if time.monotonic() - last_scan > 2.0:
            last_scan = time.monotonic()
            for name in os.listdir("/dev/input"):
                path = "/dev/input/" + name
                if name.startswith("event") and path not in fds.values():
                    try:
                        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
                    except OSError:
                        continue
                    fds[fd] = path
                    poller.register(fd, select.POLLIN)
        for fd, ev in poller.poll(2000):
            if ev & (select.POLLERR | select.POLLHUP):     # device unplugged
                poller.unregister(fd)
                os.close(fd)
                del fds[fd]
                continue
            try:
                data = os.read(fd, EVENT * 64)
            except OSError:
                continue
            for off in range(0, len(data) - EVENT + 1, EVENT):
                _, _, etype, code, value = struct.unpack_from("llHHi", data, off)
                if etype == EV_KEY and value == 1:
                    return fds[fd], code


def main():
    drm_fd = display_off()
    log("monitor off (CRTCs disabled, holding DRM master), waiting for a key")
    dev, code = wait_for_key()
    os.close(drm_fd)
    log(f"key {code} on {dev}: starting {DASHBOARD}")
    subprocess.run(["systemctl", "--no-block", "start", DASHBOARD])


if __name__ == "__main__":
    main()
