# Backend for the Pi Room idle screen: static page + /api/status + /api/stream/start on 127.0.0.1:8766.
# Always running (it never owns the display), so the page is back instantly when the stream ends.
# Also rings the alarms: paplay needs sallen's PipeWire session (lingering user, so it runs without a login).
[Unit]
Description=Pi Room dashboard backend
After=network-online.target user@1000.service
Wants=network-online.target user@1000.service

[Service]
User=sallen
Group=sallen
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/usr/bin/python3 /usr/local/bin/pi-dashboard-server
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
